@inject IJSRuntime JS
@inject HttpClient Http
@using System.Globalization
@using Properties;
<div class="navbar navbar-expand-md navbar-dark px-4">
    <div class="container-fluid d-flex align-items-center justify-content-between w-100">

        <!-- Мобильная версия: кнопка + имя -->
        <div class="d-flex align-items-center d-md-none ">
            <button class="navbar-toggler me-2" type="button" @onclick="ToggleNavMenu">
                <span class="navbar-toggler-icon"></span>
            </button>
            <a class="navbar-brand m-0 px-2" href="">@Resources.Name</a>
        </div>

        <!-- Десктопная версия: только имя -->
        <a class="navbar-brand d-none d-md-block m-0" href="">@Resources.Name</a>

        <!-- Центр: пункты меню -->
        <div class="main-menu position-absolute start-50 translate-middle-x d-none d-md-block">
            <nav class="navbar-nav flex-row">
                @if (menuItems != null)
                {
                    foreach (var item in menuItems)
                    {
                        <a class="nav-link" href="@item.Href">@Resources.ResourceManager.GetString(item.Title, Resources.Culture)</a>
                    }
                }
                @* <a class="nav-link px-2" href="/">
                    <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
                </a>
                <a class="nav-link px-2" href="counter">
                    <span class="bi bi-plus-square-fill" aria-hidden="true"></span> Counter
                </a>
                <a class="nav-link px-2" href="weather">
                    <span class="bi bi-list-nested" aria-hidden="true"></span> Weather
                </a> *@
            </nav>
        </div>
        <!-- Вертикальное меню — для мобильных -->
        <div class="@NavMenuCssClass mobile-menu d-md-none">
            <nav class="navbar-nav flex-column">
               @*  <NavLink class="nav-link" href="" Match="NavLinkMatch.All" @onclick="CloseMenu">Home</NavLink>
                <NavLink class="nav-link" href="counter" @onclick="CloseMenu">Counter</NavLink>
                <NavLink class="nav-link" href="weather" @onclick="CloseMenu">Weather</NavLink> *@
               
                @if (menuItems != null)
                {
                    foreach (var item in menuItems)
                    {
                        <a class="nav-link" href="@item.Href" @onclick="CloseMenu">@Resources.ResourceManager.GetString(item.Title, Resources.Culture)</a>
                    }
                }
            </nav>
        </div>
        <!-- Правая часть: вибор локали -->
       
        <div class="language-switcher ms-auto">
            <select class="form-select form-select-sm" @onchange="OnLanguageChanged" value="@currentCulture">
                <option value="ru">RU</option>
                <option value="uk">UA</option>
                <option value="en">EN</option>
            </select>
        </div>
    </div>
</div>

@code {
    [Inject] public NavigationManager Navigation { get; set; } = default!;
    private bool collapseNavMenu = true;
    private bool isMobile = false;
    private string currentCulture = "ru"; // значение по умолчанию


    private DotNetObjectReference<NavMenu>? objRef;

    private string? NavMenuCssClass => collapseNavMenu ? "collapse navbar-collapse" : "navbar-collapse show";

    private void ToggleNavMenu() => collapseNavMenu = !collapseNavMenu;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            objRef = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("registerResizeHandler", objRef);
            await CheckScreenSizeAsync();
            StateHasChanged();
        }
    }

    private List<MenuItem>? menuItems;

    protected override async Task OnInitializedAsync()
    {
        menuItems = await Http.GetFromJsonAsync<List<MenuItem>>("data/MenuItemsData.json");

       // var cultureFromStorage = await JS.InvokeAsync<string>("localStorage.getItem", "preferredCulture");
       // if (!string.IsNullOrEmpty(cultureFromStorage))
       // {
            currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName; ;
            // var c = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
            // if (currentCulture != CultureInfo.CurrentUICulture.TwoLetterISOLanguageName)
            // {
            //     ChangeCulture(currentCulture);
            // }
       // }
    }

    private void ChangeCulture(string culture)
    {
        // Меняем культуру на лету
        var cultureInfo = new CultureInfo(culture);
        CultureInfo.DefaultThreadCurrentCulture = cultureInfo;
        CultureInfo.DefaultThreadCurrentUICulture = cultureInfo;

        // Принудительно обновляем интерфейс (вариант 1: навигация без перезагрузки)
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }

    private async Task OnLanguageChanged(ChangeEventArgs e)
    {
        var selectedCulture = e.Value?.ToString() ?? "ru";
        currentCulture = selectedCulture;

        // Сохраняем культуру в localStorage (по желанию)
        await JS.InvokeVoidAsync("localStorage.setItem", "preferredCulture", currentCulture);

        ChangeCulture(selectedCulture);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task UpdateLayout()
    {
        await CheckScreenSizeAsync();
        StateHasChanged();
    }

    private async Task CheckScreenSizeAsync()
    {
        var width = await JS.InvokeAsync<int>("getWindowWidth");
        isMobile = width < 969;
    }

    public void Dispose()
    {
        objRef?.Dispose();
    }

    private void CloseMenu()
    {
        collapseNavMenu = true;
    }
}
